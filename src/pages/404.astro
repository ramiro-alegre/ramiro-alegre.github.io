---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Página no encontrada — Ramiro Alegre"
  description="La página que buscás no existe o cambió de lugar."
>
  <section class="mx-auto max-w-3xl px-6 py-20">
    <p class="text-sm font-medium uppercase tracking-widest text-brand">
      Error 404
    </p>
    <h1 class="mt-4 text-4xl font-bold tracking-tight text-slate-900">
      Página no encontrada
    </h1>
    <p class="mt-4 text-lg leading-relaxed text-slate-600">
      La página que buscás no existe o cambió de lugar.
    </p>

    <a
      href="/"
      class="mt-8 inline-flex items-center gap-2 rounded-lg bg-brand px-5 py-3 text-sm font-medium text-white transition-colors hover:bg-brand-dark"
    >
      Volver al inicio
    </a>
  </section>
</Layout>
