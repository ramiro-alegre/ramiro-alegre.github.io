---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import CvButton from "../components/CvButton.astro";

const contactMethods = [
  {
    label: "Mail",
    value: "alegre.ramiro222@gmail.com",
    href: "mailto:alegre.ramiro222@gmail.com",
    copy: "alegre.ramiro222@gmail.com",
    icon: "mail",
    external: false,
  },
  {
    label: "LinkedIn",
    value: "Ramiro Alegre",
    href: "https://www.linkedin.com/in/ramiroalegrejr/",
    copy: "https://www.linkedin.com/in/ramiroalegrejr/",
    icon: "linkedin",
    external: true,
  },
  {
    label: "GitHub",
    value: "ramiro-alegre",
    href: "https://github.com/ramiro-alegre",
    copy: "https://github.com/ramiro-alegre",
    icon: "github",
    external: true,
  },
] as const;
---

<Layout
  title="Contacto — Ramiro Alegre"
  description="Ponete en contacto con Ramiro Alegre."
>
  <section class="mx-auto max-w-3xl px-6 py-20">
    <h1 class="text-4xl font-bold tracking-tight text-slate-900">Contacto</h1>

    <ul class="mt-12 space-y-4">
      {
        contactMethods.map((m) => (
          <li class="flex items-center gap-4 rounded-xl border border-slate-200 bg-white p-5 transition-colors hover:border-brand hover:bg-brand-soft">
            <a
              href={m.href}
              target={m.external ? "_blank" : undefined}
              rel={m.external ? "noopener noreferrer" : undefined}
              class="flex flex-1 items-center gap-4"
            >
              <span class="text-brand">
                <Icon name={m.icon} class="h-6 w-6" />
              </span>
              <span>
                <span class="block text-sm font-medium text-slate-500">
                  {m.label}
                </span>
                <span class="block text-slate-900">{m.value}</span>
              </span>
            </a>

            <button
              type="button"
              class="copy-btn shrink-0 rounded-lg p-2 text-slate-400 transition-colors hover:bg-white hover:text-brand"
              data-copy={m.copy}
              aria-label={`Copiar ${m.label}`}
            >
              <span class="copy-idle block">
                <Icon name="copy" class="h-5 w-5" />
              </span>
              <span class="copy-done hidden text-green-600">
                <Icon name="check" class="h-5 w-5" />
              </span>
            </button>
          </li>
        ))
      }
    </ul>

    <CvButton class="mt-8" />
  </section>
</Layout>

<script>
  document.querySelectorAll<HTMLButtonElement>(".copy-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const text = btn.dataset.copy;
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        return;
      }
      const idle = btn.querySelector(".copy-idle");
      const done = btn.querySelector(".copy-done");
      idle?.classList.add("hidden");
      done?.classList.remove("hidden");
      setTimeout(() => {
        idle?.classList.remove("hidden");
        done?.classList.add("hidden");
      }, 1500);
    });
  });
</script>
