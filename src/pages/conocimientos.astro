---
import Layout from "../layouts/Layout.astro";

const knowledge = [
  { category: "Lenguajes", items: ["C#", "JavaScript", "TypeScript", "Python"] },
  {
    category: "Backend",
    items: [".NET", "ASP.NET Core", "Entity Framework Core", "RabbitMQ"],
  },
  { category: "Frontend", items: ["Angular", "HTML", "CSS", "Tailwind"] },
  { category: "Bases de datos", items: ["SQL Server", "MySQL", "Redis"] },
  { category: "Cloud", items: ["AWS Lambda", "S3", "CloudFront"] },
  {
    category: "Herramientas",
    items: ["Docker", "Git", "Testing", "Code Review", "Astro"],
  },
];
---

<Layout
  title="Conocimientos — Ramiro Alegre"
  description="Tecnologías y herramientas que uso: C#, .NET, ASP.NET Core, Angular, SQL Server, AWS, Docker y más."
>
  <section class="mx-auto max-w-3xl px-6 py-20">
    <h1 class="text-4xl font-bold tracking-tight text-slate-900">
      Conocimientos
    </h1>
    <p class="mt-4 text-lg leading-relaxed text-slate-600">
      Tecnologías y herramientas con las que trabajo, agrupadas por área.
    </p>

    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        knowledge.map((group) => (
          <div>
            <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">
              {group.category}
            </h2>
            <ul class="mt-3 flex flex-wrap gap-2">
              {group.items.map((item) => (
                <li class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-sm text-slate-700">
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
</Layout>
