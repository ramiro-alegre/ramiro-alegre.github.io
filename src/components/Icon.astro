---
interface Props {
  name:
    | "github"
    | "linkedin"
    | "codepen"
    | "mail"
    | "external"
    | "download"
    | "database"
    | "arrow"
    | "copy"
    | "check";
  class?: string;
}

const { name, class: className = "h-5 w-5" } = Astro.props;

const filled = ["github", "linkedin", "codepen"];
const isFilled = filled.includes(name);

