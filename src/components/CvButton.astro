---
import Icon from "./Icon.astro";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<a
  href="/cv/Ramiro-Alegre-CV.pdf"
  target="_blank"
  rel="noopener"
  class:list={[
    "inline-flex items-center gap-2 rounded-lg border border-slate-300 px-5 py-3 text-sm font-medium text-slate-700 transition-colors hover:border-slate-400 hover:bg-slate-50",
    className,
  ]}
>
  <Icon name="external" class="h-4 w-4" />
  Ver CV
</a>
