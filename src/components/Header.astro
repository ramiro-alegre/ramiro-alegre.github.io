---
const path = Astro.url.pathname;

const links = [
  { href: "/", label: "Inicio" },
  { href: "/proyectos", label: "Proyectos" },
  { href: "/conocimientos", label: "Conocimientos" },
  { href: "/contacto", label: "Contacto" },
];

const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);

const linkClass = (href: string) =>
  isActive(href)
    ? "text-brand font-medium"
    : "text-slate-600 transition-colors hover:text-slate-900";
---

<header
  class="sticky top-0 z-50 border-b border-slate-200/70 bg-white/80 backdrop-blur"
>
  <nav class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
    <a
      href="/"
      class="text-lg font-bold tracking-tight text-slate-900 hover:text-brand"
    >
      Ramiro Alegre
    </a>

    <ul class="hidden items-center gap-8 text-sm md:flex">
      {
        links.map((l) => (
          <li>
            <a href={l.href} class={linkClass(l.href)}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <button
      id="menu-toggle"
      class="text-slate-700 md:hidden"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="menu-panel"
    >
      <svg
        class="h-6 w-6"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      >
        <line x1="4" y1="7" x2="20" y2="7"></line>
        <line x1="4" y1="12" x2="20" y2="12"></line>
        <line x1="4" y1="17" x2="20" y2="17"></line>
      </svg>
    </button>
  </nav>

  <div id="menu-panel" class="hidden border-t border-slate-200 md:hidden">
    <ul class="flex flex-col px-6 py-2">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class={`block py-2 text-sm ${linkClass(l.href)}`}
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  const btn = document.getElementById("menu-toggle");
  const panel = document.getElementById("menu-panel");
  btn?.addEventListener("click", () => {
    const isHidden = panel?.classList.toggle("hidden");
    btn.setAttribute("aria-expanded", String(!isHidden));
    btn.setAttribute("aria-label", isHidden ? "Abrir menú" : "Cerrar menú");
  });
</script>
